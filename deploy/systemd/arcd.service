[Unit]
Description=AgenC Relay daemon (ARCD)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcd
Group=arcd
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/tor/arcd /var/lib/arcd-operator
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
LimitMEMLOCK=infinity
RuntimeDirectory=arcd
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=arcd/state arcd/backups arcd/logs
StateDirectoryMode=0700
LogsDirectory=arcd
LogsDirectoryMode=0700
ReadOnlyPaths=/var/lib/arcd/keys /var/lib/arcd/trust
ReadWritePaths=/var/lib/arcd/state /var/lib/arcd/backups /var/lib/arcd/logs /var/log/arcd /run/arcd
ExecStartPre=/usr/bin/setfacl --modify group:arcd-sockets:r-x,default:group:arcd-sockets:rw- /run/arcd
ExecStartPre=/usr/bin/arcd check-config --config /etc/arcd/config.toml
ExecStart=/usr/bin/arcd serve --config /etc/arcd/config.toml
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure

[Install]
WantedBy=multi-user.target
