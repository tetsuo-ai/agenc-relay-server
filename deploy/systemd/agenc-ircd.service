[Unit]
Description=AgenC IRC daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenc-ircd
Group=agenc-ircd
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @raw-io
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
LimitMEMLOCK=infinity
RuntimeDirectory=agenc-ircd
RuntimeDirectoryMode=0700
StateDirectory=agenc-ircd/state agenc-ircd/backups agenc-ircd/logs
StateDirectoryMode=0700
LogsDirectory=agenc-ircd
LogsDirectoryMode=0700
ReadOnlyPaths=/var/lib/agenc-ircd/keys /var/lib/agenc-ircd/trust
ReadWritePaths=/var/lib/agenc-ircd/state /var/lib/agenc-ircd/backups /var/lib/agenc-ircd/logs /var/log/agenc-ircd /run/agenc-ircd
ExecStartPre=/usr/bin/agenc-ircd check-config --config /etc/agenc-ircd/config.toml
ExecStart=/usr/bin/agenc-ircd serve --config /etc/agenc-ircd/config.toml
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure

[Install]
WantedBy=multi-user.target
