+/// Result of an experimental allocation probe that did not publish a transaction.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AllocationProbeRefusal {
+    /// The cumulative rounded page allocation limit was exhausted.
+    Exhausted,
+    /// Publication is unavailable until bounded commit preparation is implemented.
+    CommitUnavailable,
+}
+
+impl Display for AllocationProbeRefusal {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Exhausted => write!(f, "Allocation probe exhausted"),
+            Self::CommitUnavailable => write!(f, "Allocation probe cannot publish"),
+        }
+    }
+}
+
