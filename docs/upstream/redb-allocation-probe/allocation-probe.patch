diff --git a/tests/allocation_probe.rs b/tests/allocation_probe.rs
new file mode 100644
index 0000000..5b95353
--- /dev/null
+++ b/tests/allocation_probe.rs
@@ -0,0 +1,239 @@
+#![forbid(unsafe_code)]
+
+use redb::{
+    AllocationProbeRefusal, CommitError, Database, ReadableDatabase, ReadableTable, StorageError,
+    TableDefinition,
+};
+
+const TABLE: TableDefinition<u64, &[u8]> = TableDefinition::new("allocation_probe");
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+fn seeded(file: &tempfile::NamedTempFile) -> Result<Database, Box<dyn std::error::Error>> {
+    let database = Database::create(file.path())?;
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(1, b"original".as_slice())?;
+    }
+    transaction.commit()?;
+    Ok(database)
+}
+
+fn assert_original(database: &Database) -> TestResult {
+    let read = database.begin_read()?;
+    let table = read.open_table(TABLE)?;
+    assert_eq!(
+        table.get(1)?.ok_or("missing original row")?.value(),
+        b"original"
+    );
+    assert!(table.get(2)?.is_none());
+    assert!(table.get(3)?.is_none());
+    Ok(())
+}
+
+fn assert_reusable(database: &Database) -> TestResult {
+    assert_original(database)?;
+    let transaction = database.begin_write()?;
+    transaction
+        .open_table(TABLE)?
+        .insert(4, b"later writer".as_slice())?;
+    transaction.commit()?;
+    Ok(())
+}
+
+#[test]
+fn allocation_refusal_can_explicitly_abort_and_reuse_the_database() -> TestResult {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let pinned = database.begin_read()?;
+    let transaction = database.begin_write_allocation_probe(8192)?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(2, b"tentative".as_slice())?;
+        assert_eq!(
+            table.get(2)?.ok_or("missing tentative row")?.value(),
+            b"tentative"
+        );
+        let large = vec![7; 65536];
+        assert!(matches!(
+            table.insert(3, large.as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+    }
+    transaction.abort()?;
+    assert_eq!(
+        pinned
+            .open_table(TABLE)?
+            .get(1)?
+            .ok_or("missing pinned row")?
+            .value(),
+        b"original"
+    );
+    assert_reusable(&database)?;
+    drop(pinned);
+    drop(database);
+    let reopened = Database::open(file.path())?;
+    assert_original(&reopened)?;
+    assert_eq!(
+        reopened
+            .begin_read()?
+            .open_table(TABLE)?
+            .get(4)?
+            .ok_or("missing later row")?
+            .value(),
+        b"later writer"
+    );
+    Ok(())
+}
+
+#[test]
+fn ignored_allocation_refusal_cannot_commit_or_poison_the_next_writer() -> TestResult {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let transaction = database.begin_write_allocation_probe(8192)?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(2, b"tentative".as_slice())?;
+        let large = vec![7; 65536];
+        assert!(matches!(
+            table.insert(3, large.as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+        assert!(matches!(
+            table.insert(3, large.as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+    }
+    assert!(matches!(
+        transaction.commit(),
+        Err(CommitError::AllocationProbe(
+            AllocationProbeRefusal::Exhausted
+        ))
+    ));
+    assert_reusable(&database)?;
+    drop(database);
+    assert_original(&Database::open(file.path())?)?;
+    Ok(())
+}
+
+#[test]
+fn unexhausted_probe_commit_aborts_without_entering_publication() -> TestResult {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let transaction = database.begin_write_allocation_probe(1024 * 1024)?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    assert!(matches!(
+        transaction.commit(),
+        Err(CommitError::AllocationProbe(
+            AllocationProbeRefusal::CommitUnavailable
+        ))
+    ));
+    assert_reusable(&database)?;
+    Ok(())
+}
+
+#[test]
+fn zero_budget_refuses_the_first_copy_on_write_allocation() -> TestResult {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let transaction = database.begin_write_allocation_probe(0)?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        assert!(matches!(
+            table.insert(2, b"tentative".as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+    }
+    transaction.abort()?;
+    assert_reusable(&database)?;
+    Ok(())
+}
+
+#[test]
+fn allocation_limit_is_shared_by_tables_in_the_same_transaction() -> TestResult {
+    const OTHER: TableDefinition<u64, &[u8]> = TableDefinition::new("other");
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let seed = database.begin_write()?;
+    seed.open_table(OTHER)?
+        .insert(1, b"other original".as_slice())?;
+    seed.commit()?;
+    let transaction = database.begin_write_allocation_probe(4096)?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    {
+        let mut other = transaction.open_table(OTHER)?;
+        assert!(matches!(
+            other.insert(2, b"must refuse".as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+    }
+    transaction.abort()?;
+    assert_reusable(&database)?;
+    let read = database.begin_read()?;
+    let other = read.open_table(OTHER)?;
+    assert_eq!(
+        other.get(1)?.ok_or("missing other original")?.value(),
+        b"other original"
+    );
+    assert!(other.get(2)?.is_none());
+    Ok(())
+}
+
+#[test]
+fn refusal_during_a_branch_update_preserves_the_entire_old_tree() -> TestResult {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = seeded(&file)?;
+    let seed = database.begin_write()?;
+    let value = [9; 128];
+    {
+        let mut table = seed.open_table(TABLE)?;
+        for key in 10..210 {
+            table.insert(key, value.as_slice())?;
+        }
+    }
+    seed.commit()?;
+    let pinned = database.begin_read()?;
+    let transaction = database.begin_write_allocation_probe(4096)?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        assert!(matches!(
+            table.insert(100, b"replacement".as_slice()),
+            Err(StorageError::AllocationProbe(
+                AllocationProbeRefusal::Exhausted
+            ))
+        ));
+    }
+    transaction.abort()?;
+    for read in [pinned, database.begin_read()?] {
+        let table = read.open_table(TABLE)?;
+        for key in 10..210 {
+            assert_eq!(table.get(key)?.ok_or("missing seeded row")?.value(), value);
+        }
+    }
+    assert_reusable(&database)?;
+    drop(database);
+    let reopened = Database::open(file.path())?;
+    let read = reopened.begin_read()?;
+    let table = read.open_table(TABLE)?;
+    for key in 10..210 {
+        assert_eq!(
+            table.get(key)?.ok_or("missing reopened row")?.value(),
+            value
+        );
+    }
+    Ok(())
+}
