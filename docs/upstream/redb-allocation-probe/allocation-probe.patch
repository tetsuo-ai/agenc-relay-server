+
+struct AllocationProbeBudget {
+    remaining: u64,
+    exhausted: bool,
+}
+
+impl AllocationProbeBudget {
+    fn charge(&mut self, size: usize, page_size: usize) -> Result<()> {
+        let debit = size
+            .div_ceil(page_size)
+            .checked_next_power_of_two()
+            .and_then(|pages| pages.checked_mul(page_size))
+            .and_then(|bytes| u64::try_from(bytes).ok());
+        if !self.exhausted
+            && let Some(remaining) = debit.and_then(|bytes| self.remaining.checked_sub(bytes))
+        {
+            self.remaining = remaining;
+            return Ok(());
+        }
+        self.exhausted = true;
+        Err(StorageError::AllocationProbe(
+            AllocationProbeRefusal::Exhausted,
+        ))
+    }
