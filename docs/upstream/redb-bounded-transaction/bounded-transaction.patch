+#[test]
+fn held_readers_retry_and_a_second_ordinary_writer_follow_a_refusal_over_fragmented_pages()
+-> TestResult {
+    let (_file, database) = seeded_file()?;
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in 100..1_100 {
+            table.insert(key, [3; 700].as_slice())?;
+        }
+    }
+    transaction.commit()?;
+    // Free every other leaf so later allocations land in fragmented free space.
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in (100..1_100).step_by(2) {
+            table.remove(key)?;
+        }
+    }
+    transaction.commit()?;
+    let reader = database.begin_read()?;
+    let before = rows(&database, TABLE);
+
+    let transaction = database.begin_write_bounded(AllocationAllowance::new(4096))?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        let mut refused = None;
+        for key in 2_000..2_100 {
+            if let Err(error) = table.insert(key, [4; 700].as_slice()) {
+                refused = Some(storage_refusal(error));
+                break;
+            }
+        }
+        assert!(matches!(refused, Some(AllowanceRefusal::Exhausted { .. })));
+    }
+    assert!(transaction.prepare().is_err());
+    assert_eq!(rows(&database, TABLE), before);
+
+    let retry = database.begin_write_bounded(GENEROUS)?;
+    {
+        let mut table = retry.open_table(TABLE)?;
+        for key in 2_000..2_100 {
+            table.insert(key, [4; 700].as_slice())?;
+        }
+    }
+    retry.prepare()?.publish()?;
+    assert_eq!(rows(&database, TABLE).len(), before.len() + 100);
+    assert_eq!(reader.open_table(TABLE)?.len()?, before.len() as u64);
+    drop(reader);
+    assert_reusable(&database)?;
+    Ok(())
+}
