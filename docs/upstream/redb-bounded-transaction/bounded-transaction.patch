+    /// Begins a write transaction whose physical growth is bounded by `allowance`.
+    ///
+    /// See [`AllocationAllowance`] for the accounting and [`BoundedWriteTransaction`] for the
+    /// explicit phases. Like [`Self::begin_write`], the transaction keeps the database open.
+    pub fn begin_write_bounded(
+        &self,
+        allowance: AllocationAllowance,
+    ) -> Result<BoundedWriteTransaction, TransactionError> {
+        let account = AllocationAccount::new(allowance.bytes(), AllocationPhase::Mutation);
+        let inner = begin_write_with_allocation_policy(
+            &self.transaction_tracker,
+            &self.mem,
+            AllocationPolicy::Default,
+            Some(account),
+        )?;
+        Ok(BoundedWriteTransaction::new(inner))
+    }
+
+    /// Reclaims pages freed by earlier transactions in one bounded publication.
+    ///
+    /// Bounded transactions never reclaim on their own; this is their deferred cleanup. At most
+    /// `max_records` freed-page records (each naming up to a few hundred pages) of transactions
+    /// no live reader or savepoint still needs are removed and their pages returned to the
+    /// allocator, all within `allowance`. Progress is monotonic: every publication removes its
+    /// records durably, so repeating the call with the same arguments finishes once every reader
+    /// has released. A refusal reclaims nothing and leaves the database usable.
+    ///
+    /// `remaining` describes the horizon of this publication. The records an ordinary
+    /// [`WriteTransaction`] commit's epilogue stores stay pinned until a durable commit clears
+    /// that epilogue, so they become eligible one publication later; a workload of bounded
+    /// transactions alone has no epilogues.
+    pub fn reclaim_bounded(
+        &self,
+        allowance: AllocationAllowance,
+        max_records: usize,
+    ) -> Result<ReclaimProgress, Error> {
+        let account = AllocationAccount::new(allowance.bytes(), AllocationPhase::Cleanup);
+        let mut transaction = begin_write_with_allocation_policy(
+            &self.transaction_tracker,
+            &self.mem,
+            AllocationPolicy::Default,
+            Some(account),
+        )?;
+        transaction.disable_post_commit_free();
+        let publication = transaction.commit_bounded(max_records)?;
+        Ok(ReclaimProgress {
+            records: publication.reclaimed_records,
+            pages: publication.reclaimed_pages,
+            remaining: publication.more_reclaimable,
+        })
+    }
+
+    /// Persists the allocator state within `allowance`, so that the next open needs no repair,
+    /// and takes that duty away from the close path.
+    ///
+    /// Dropping a [`Database`] otherwise runs an unbounded transaction that writes the allocator
+    /// state and trims the file. After this call, whatever its outcome, the drop only flushes
+    /// and closes the file: on a refusal the state is not written and the next open repairs it,
+    /// which is the same recovery a crash requires. A later write transaction restores the
+    /// ordinary close behavior.
+    pub fn persist_allocator_state_bounded(
+        &self,
+        allowance: AllocationAllowance,
+    ) -> Result<(), Error> {
+        let account = AllocationAccount::new(allowance.bytes(), AllocationPhase::Close);
+        let result = (|| -> Result<(), Error> {
+            let mut transaction = begin_write_with_allocation_policy(
+                &self.transaction_tracker,
+                &self.mem,
+                AllocationPolicy::Lowest,
+                Some(account),
+            )?;
+            transaction.set_quick_repair(true);
+            transaction.disable_post_commit_free();
+            transaction.set_shrink_policy(ShrinkPolicy::Maximum);
+            transaction.commit_bounded(0)?;
+            Ok(())
+        })();
+        // Set after the transaction began, which cleared it, and regardless of the outcome:
+        // the close path must never run its own unmetered allocations after a bounded close.
+        self.mem.set_close_persist_handled(true);
+        result
+    }
 }
 
