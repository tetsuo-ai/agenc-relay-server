+#[test]
+fn bounded_close_persists_the_allocator_state_or_leaves_the_repair_to_the_next_open() -> TestResult {
+    fn reopen_counting_repairs(path: &std::path::Path) -> Result<(Database, bool), Box<dyn std::error::Error>> {
+        let repaired = Arc::new(Mutex::new(false));
+        let flag = repaired.clone();
+        let database = Database::builder()
+            .set_repair_callback(move |_| *flag.lock().unwrap() = true)
+            .open(path)?;
+        let repaired = *repaired.lock().unwrap();
+        Ok((database, repaired))
+    }
+
+    let (file, database) = seeded_file()?;
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    transaction.open_table(TABLE)?.insert(2, b"kept".as_slice())?;
+    transaction.prepare()?.publish()?;
+    // A refused persist writes no allocator state, and the drop must not write it either.
+    let refused = database.persist_allocator_state_bounded(AllocationAllowance::new(0));
+    let refusal = match refused.unwrap_err() {
+        Error::Allowance(refusal) => refusal,
+        other => panic!("{other:?}"),
+    };
+    assert_eq!(refusal.phase(), AllocationPhase::Close);
+    drop(database);
+    let (reopened, repaired) = reopen_counting_repairs(file.path())?;
+    assert!(repaired, "the next open repaired the allocator state");
+    assert_eq!(
+        rows(&reopened, TABLE),
+        vec![(1, b"original".to_vec()), (2, b"kept".to_vec())]
+    );
+
+    // A successful bounded persist leaves nothing for the next open to repair.
+    reopened.persist_allocator_state_bounded(GENEROUS)?;
+    drop(reopened);
+    let (reopened, repaired) = reopen_counting_repairs(file.path())?;
+    assert!(!repaired, "the persisted allocator state was used");
+    assert_eq!(rows(&reopened, TABLE).len(), 2);
+
+    // A later writer restores the ordinary close, which persists the state unbounded.
+    let transaction = reopened.begin_write()?;
+    transaction.open_table(TABLE)?.insert(3, b"later".as_slice())?;
+    transaction.commit()?;
+    drop(reopened);
+    let (reopened, repaired) = reopen_counting_repairs(file.path())?;
+    assert!(!repaired);
+    assert_eq!(rows(&reopened, TABLE).len(), 3);
+    Ok(())
+}
