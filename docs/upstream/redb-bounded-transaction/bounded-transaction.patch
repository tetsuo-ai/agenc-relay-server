+#[test]
+fn bounded_commit_publishes_every_kind_of_change_and_survives_reopen() -> TestResult {
+    let (file, database) = seeded_file()?;
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    assert_eq!(transaction.phase()?, AllocationPhase::Mutation);
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(1, b"replaced".as_slice())?;
+        table.insert(2, b"inserted".as_slice())?;
+        table.insert(3, b"doomed".as_slice())?;
+        table.remove(3)?;
+        let mut other = transaction.open_table(OTHER)?;
+        other.insert(10, b"".as_slice())?;
+        other.insert(11, vec![7; 1 << 20].as_slice())?;
+    }
+    assert!(transaction.allowance_charged()? > 0);
+    let prepared = transaction.prepare()?;
+    let charged = prepared.allowance_charged()?;
+    prepared.publish()?;
+    assert_eq!(
+        rows(&database, TABLE),
+        vec![(1, b"replaced".to_vec()), (2, b"inserted".to_vec())]
+    );
+    assert_reusable(&database)?;
+    drop(database);
+    let reopened = Database::open(file.path())?;
+    assert_eq!(
+        rows(&reopened, TABLE),
+        vec![(1, b"replaced".to_vec()), (2, b"inserted".to_vec())]
+    );
+    let other = rows(&reopened, OTHER);
+    assert_eq!(other.len(), 2);
+    assert_eq!(other[0], (10, vec![]));
+    assert_eq!(other[1].1.len(), 1 << 20);
+    assert!(charged >= 1 << 20, "the large value was charged: {charged}");
+    Ok(())
+}
