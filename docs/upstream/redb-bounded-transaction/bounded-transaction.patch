+#[test]
+fn a_bounded_transaction_keeps_the_database_open_and_its_reader_pages_intact() -> TestResult {
+    let (file, database) = seeded_file()?;
+    let reader = database.begin_read()?;
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    drop(database);
+    transaction.open_table(TABLE)?.insert(1, b"changed".as_slice())?;
+    transaction.prepare()?.publish()?;
+    assert_eq!(
+        reader.open_table(TABLE)?.get(1)?.unwrap().value(),
+        b"original",
+        "a retained reader keeps its snapshot"
+    );
+    drop(reader);
+    let reopened = Database::open(file.path())?;
+    assert_eq!(rows(&reopened, TABLE), vec![(1, b"changed".to_vec())]);
+    Ok(())
+}
