+#![forbid(unsafe_code)]
+
+//! Bounded write transactions: typed allowance, explicit phases, clean refusal, crash safety,
+//! bounded reclamation, and bounded close.
+
+use redb::backends::InMemoryBackend;
+use redb::{
+    AllocationAllowance, AllocationPhase, AllowanceRefusal, CommitError, Database, Error,
+    ReadableDatabase, ReadableTable, ReadableTableMetadata, StorageBackend, StorageError,
+    TableDefinition, TableError,
+};
+use std::io::ErrorKind;
+use std::sync::{Arc, Mutex};
+
+const TABLE: TableDefinition<u64, &[u8]> = TableDefinition::new("bounded");
+const OTHER: TableDefinition<u64, &[u8]> = TableDefinition::new("other");
+const GENEROUS: AllocationAllowance = AllocationAllowance::new(1 << 30);
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Op {
+    Write { offset: u64, len: usize },
+    SetLen(u64),
+    Sync,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    live: Vec<u8>,
+    durable: Vec<u8>,
+    last_header: Vec<u8>,
+    syncs: u64,
+    freeze_from: Option<u64>,
+    writes: u64,
+    fail_write_at: Option<u64>,
+    log: Vec<Op>,
+}
+
+/// An in-memory backend that records every operation, can freeze durability at a sync count to
+/// produce the file image a crash at that sync leaves, and can fail one write.
+#[derive(Clone, Debug, Default)]
+struct RecordingBackend {
+    state: Arc<Mutex<State>>,
+}
+
+impl RecordingBackend {
+    fn from_image(image: Vec<u8>) -> Self {
+        let backend = Self::default();
+        {
+            let mut state = backend.state.lock().unwrap();
+            state.durable = image.clone();
+            state.live = image;
+        }
+        backend
+    }
+
+    fn syncs(&self) -> u64 {
+        self.state.lock().unwrap().syncs
+    }
+
+    fn freeze_at(&self, sync: u64) {
+        self.state.lock().unwrap().freeze_from = Some(sync);
+    }
+
+    fn fail_write_at(&self, write: u64) {
+        self.state.lock().unwrap().fail_write_at = Some(write);
+    }
+
+    fn crash_image(&self) -> Vec<u8> {
+        let state = self.state.lock().unwrap();
+        let mut image = state.durable.clone();
+        if !state.last_header.is_empty() && image.len() >= state.last_header.len() {
+            image[..state.last_header.len()].copy_from_slice(&state.last_header);
+        }
+        image
+    }
+
+    fn log_len(&self) -> usize {
+        self.state.lock().unwrap().log.len()
+    }
+
+    fn log_since(&self, start: usize) -> Vec<Op> {
+        self.state.lock().unwrap().log[start..].to_vec()
+    }
+
+    fn len(&self) -> u64 {
+        self.state.lock().unwrap().live.len() as u64
+    }
+}
+
+impl StorageBackend for RecordingBackend {
+    fn len(&self) -> Result<u64, std::io::Error> {
+        Ok(self.state.lock().unwrap().live.len() as u64)
+    }
+
+    fn read(&self, offset: u64, out: &mut [u8]) -> Result<(), std::io::Error> {
+        let state = self.state.lock().unwrap();
+        let offset = usize::try_from(offset).unwrap();
+        if offset + out.len() > state.live.len() {
+            return Err(std::io::Error::from(ErrorKind::UnexpectedEof));
+        }
+        out.copy_from_slice(&state.live[offset..offset + out.len()]);
+        Ok(())
+    }
+
+    fn set_len(&self, len: u64) -> Result<(), std::io::Error> {
+        let mut state = self.state.lock().unwrap();
+        state.log.push(Op::SetLen(len));
+        state.live.resize(usize::try_from(len).unwrap(), 0);
+        Ok(())
+    }
+
+    fn sync_data(&self) -> Result<(), std::io::Error> {
+        let mut state = self.state.lock().unwrap();
+        state.log.push(Op::Sync);
+        state.syncs += 1;
+        if state.freeze_from.is_none_or(|f| state.syncs < f) {
+            state.durable = state.live.clone();
+        }
+        Ok(())
+    }
+
+    fn write(&self, offset: u64, data: &[u8]) -> Result<(), std::io::Error> {
+        let mut state = self.state.lock().unwrap();
+        state.writes += 1;
+        if state.fail_write_at == Some(state.writes) {
+            return Err(std::io::Error::other("injected write failure"));
+        }
+        state.log.push(Op::Write {
+            offset,
+            len: data.len(),
+        });
+        let offset = usize::try_from(offset).unwrap();
+        if offset + data.len() > state.live.len() {
+            state.live.resize(offset + data.len(), 0);
+        }
+        state.live[offset..offset + data.len()].copy_from_slice(data);
+        // A header write reaches the disk page cache even when the following sync does not
+        // complete, but nothing written after the crash point exists at all.
+        if offset == 0 && state.freeze_from.is_none_or(|f| state.syncs < f) {
+            state.last_header = data.to_vec();
+        }
+        Ok(())
+    }
+}
+
+fn memory_database() -> Result<Database, Box<dyn std::error::Error>> {
+    Ok(Database::builder().create_with_backend(InMemoryBackend::new())?)
+}
+
+fn seeded_file() -> Result<(tempfile::NamedTempFile, Database), Box<dyn std::error::Error>> {
+    let file = tempfile::NamedTempFile::new()?;
+    let database = Database::create(file.path())?;
+    seed(&database)?;
+    Ok((file, database))
+}
+
+fn seed(database: &Database) -> TestResult {
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(1, b"original".as_slice())?;
+    }
+    transaction.commit()?;
+    Ok(())
+}
+
+fn rows(database: &Database, definition: TableDefinition<u64, &[u8]>) -> Vec<(u64, Vec<u8>)> {
+    let read = database.begin_read().unwrap();
+    let Ok(table) = read.open_table(definition) else {
+        return vec![];
+    };
+    table
+        .iter()
+        .unwrap()
+        .map(|entry| {
+            let (key, value) = entry.unwrap();
+            (key.value(), value.value().to_vec())
+        })
+        .collect()
+}
+
+fn assert_original(database: &Database) {
+    assert_eq!(rows(database, TABLE), vec![(1, b"original".to_vec())]);
+}
+
+fn assert_reusable(database: &Database) -> TestResult {
+    let transaction = database.begin_write()?;
+    transaction
+        .open_table(TABLE)?
+        .insert(4, b"later writer".as_slice())?;
+    transaction.commit()?;
+    let transaction = database.begin_write()?;
+    transaction.open_table(TABLE)?.remove(4)?;
+    transaction.commit()?;
+    Ok(())
+}
+
+fn refusal_of(error: CommitError) -> AllowanceRefusal {
+    match error {
+        CommitError::Allowance(refusal) => refusal,
+        other => panic!("expected an allowance refusal, got {other:?}"),
+    }
+}
+
+fn storage_refusal(error: StorageError) -> AllowanceRefusal {
+    match error {
+        StorageError::Allowance(refusal) => refusal,
+        other => panic!("expected an allowance refusal, got {other:?}"),
+    }
+}
