+#[test]
+fn an_io_failure_during_mutation_makes_the_abort_fail_without_hiding_it() -> TestResult {
+    let backend = RecordingBackend::default();
+    // A small cache makes a large value reach the backend during the mutation itself.
+    let database = Database::builder()
+        .set_cache_size(256 * 1024)
+        .create_with_backend(backend.clone())?;
+    seed(&database)?;
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    let writes = backend.state.lock().unwrap().writes;
+    backend.fail_write_at(writes + 1);
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        // A large value is written straight through the cache to the backend.
+        let error = table.insert(3, vec![1; 1 << 21].as_slice()).err().expect("expected an error");
+        assert!(matches!(error, StorageError::Io(_)), "{error:?}");
+    }
+    let error = transaction.abort().unwrap_err();
+    assert!(
+        matches!(error, StorageError::Io(_) | StorageError::PreviousIo),
+        "{error:?}"
+    );
+    assert!(database.begin_write().is_err());
+    Ok(())
+}
