+        let mut table = transaction.open_table(TABLE)?;
+        for key in 10..2_000 {
+            table.insert(key, [8; 1024].as_slice())?;
+        }
+    }
+    let prepared = transaction.prepare()?;
+    let start = backend.log_len();
+    let length = backend.len();
+    prepared.publish()?;
+    let publication = backend.log_since(start);
+    assert!(!publication.is_empty());
+    for op in &publication {
+        match op {
+            Op::Write { offset, .. } => {
+                assert!(*offset < length, "publication wrote inside the prepared file: {op:?}");
+            }
+            Op::SetLen(len) => assert!(*len <= length, "publication extended the file: {op:?}"),
+            Op::Sync => {}
+        }
+    }
+    let syncs = publication.iter().filter(|op| **op == Op::Sync).count();
+    assert!(syncs >= 1, "publication flushes: {publication:?}");
+    let header_writes = publication
+        .iter()
+        .filter(|op| matches!(op, Op::Write { offset: 0, .. }))
+        .count();
+    assert!(header_writes >= 1, "publication writes the header: {publication:?}");
+    assert_eq!(backend.len(), length, "the file length is unchanged by publication");
+    assert_eq!(rows(&database, TABLE).len(), 1_991);
+    Ok(())
+}
+
+/// A crash at any sync of the publication, or before it, leaves exactly the old or the new
+/// roots: never a hybrid, and the reopened database passes a full integrity check and keeps
+/// accepting writes.
+#[test]
+fn crash_before_preparation_after_preparation_and_at_every_publish_sync_recovers_old_or_new()
+-> TestResult {
+    fn workload(database: &Database) -> Result<(u64, u64), Box<dyn std::error::Error>> {
+        let transaction = database.begin_write_bounded(GENEROUS)?;
+        {
+            let mut table = transaction.open_table(TABLE)?;
+            table.insert(1, b"new".as_slice())?;
+            for key in 10..1_500 {
+                table.insert(key, [6; 1024].as_slice())?;
+            }
+        }
+        let prepared = transaction.prepare()?;
+        let syncs_before_publish = prepared.allowance_charged().map(|_| 0)?;
+        let _ = syncs_before_publish;
+        prepared.publish()?;
+        Ok((0, 0))
+    }
+    // Count the syncs the seed and the workload perform.
+    let probe = RecordingBackend::default();
+    let (after_seed, total) = {
+        let database = Database::builder().create_with_backend(probe.clone())?;
+        seed(&database)?;
+        let after_seed = probe.syncs();
+        workload(&database)?;
+        (after_seed, probe.syncs())
+    };
+    assert!(total > after_seed);
+
+    let mut outcomes = vec![];
+    for freeze in after_seed + 1..=total + 1 {
+        let backend = RecordingBackend::default();
+        let database = Database::builder().create_with_backend(backend.clone())?;
+        seed(&database)?;
+        backend.freeze_at(freeze);
+        let _ = workload(&database);
+        let image = backend.crash_image();
+        std::mem::forget(database);
+        let mut reopened = Database::builder()
+            .create_with_backend(RecordingBackend::from_image(image))?;
+        assert!(reopened.check_integrity()?, "freeze at sync {freeze}");
+        let rows = rows(&reopened, TABLE);
+        let outcome = match rows.first() {
+            Some((1, value)) if value == b"original" => {
+                assert_eq!(rows.len(), 1, "old roots at sync {freeze}");
+                "old"
+            }
+            Some((1, value)) if value == b"new" => {
+                assert_eq!(rows.len(), 1_491, "new roots at sync {freeze}");
+                "new"
+            }
+            other => panic!("hybrid state at sync {freeze}: {other:?}"),
+        };
+        outcomes.push(outcome);
+        // No double free or reused reader page: more writes and another check succeed.
+        let transaction = reopened.begin_write()?;
+        {
+            let mut table = transaction.open_table(TABLE)?;
+            for key in 5_000..5_500 {
+                table.insert(key, [2; 1024].as_slice())?;
+            }
+        }
+        transaction.commit()?;
+        assert!(reopened.check_integrity()?);
+    }
+    assert!(outcomes.contains(&"old"), "{outcomes:?}");
+    assert!(outcomes.contains(&"new"), "{outcomes:?}");
+    Ok(())
+}
