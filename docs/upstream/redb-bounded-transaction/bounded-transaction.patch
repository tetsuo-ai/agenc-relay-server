+        Arc::new(Mutex::new(Self {
+            remaining: allowance,
+            charged: 0,
+            phase,
+            latched: None,
+        }))
+    }
+
+    /// The bytes one allocation of `size` occupies: whole pages rounded up to the buddy order.
+    pub(crate) fn extent_bytes(size: usize, page_size: usize) -> Option<u64> {
+        size.div_ceil(page_size)
+            .checked_next_power_of_two()
+            .and_then(|pages| pages.checked_mul(page_size))
+            .and_then(|bytes| u64::try_from(bytes).ok())
