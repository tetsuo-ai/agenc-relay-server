+#[test]
+fn a_preparation_refusal_aborts_cleanly_and_the_next_writer_is_unaffected() -> TestResult {
+    let (file, database) = seeded_file()?;
+    // Fill the freed tables with work for preparation: many pages freed by earlier commits.
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in 100..400 {
+            table.insert(key, [5; 512].as_slice())?;
+        }
+    }
+    transaction.commit()?;
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in 100..400 {
+            table.remove(key)?;
+        }
+    }
+    transaction.commit()?;
+    let before = rows(&database, TABLE);
+
+    // Find the mutation charge of one small write, then allow exactly that: preparation's own
+    // system-table pages cannot fit.
+    let probe = database.begin_write_bounded(GENEROUS)?;
+    probe.open_table(TABLE)?.insert(2, b"tentative".as_slice())?;
+    let mutation_charge = probe.allowance_charged()?;
+    probe.abort()?;
+    let pinned = database.begin_read()?;
+    let transaction = database.begin_write_bounded(AllocationAllowance::new(mutation_charge))?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    assert_eq!(transaction.refusal()?, None);
+    let refusal = refusal_of(transaction.prepare().unwrap_err());
+    assert!(
+        matches!(
+            refusal,
+            AllowanceRefusal::Exhausted {
+                phase: AllocationPhase::Preparation,
+                ..
+            }
+        ),
+        "{refusal:?}"
+    );
+    assert_eq!(rows(&database, TABLE), before);
+    assert_eq!(
+        pinned.open_table(TABLE)?.get(1)?.unwrap().value(),
+        b"original"
+    );
+    drop(pinned);
+    assert_reusable(&database)?;
+    // The allocator state was restored exactly: a full integrity check agrees with it.
+    drop(database);
+    let mut reopened = Database::open(file.path())?;
+    assert!(reopened.check_integrity()?);
+    assert_eq!(rows(&reopened, TABLE), before);
+    Ok(())
+}
