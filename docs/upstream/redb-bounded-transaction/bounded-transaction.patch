+#[test]
+fn cumulative_allocations_across_tables_share_one_allowance_and_reuse_never_refunds() -> TestResult {
+    let (_file, database) = seeded_file()?;
+    let seed = database.begin_write()?;
+    seed.open_table(OTHER)?.insert(1, b"other".as_slice())?;
+    seed.commit()?;
+    let transaction = database.begin_write_bounded(AllocationAllowance::new(8192))?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    let charged_after_first = transaction.allowance_charged()?;
+    assert!(charged_after_first > 0);
+    {
+        // Rewriting the same leaf reuses this transaction's own page: no new extent.
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(2, b"tentative again".as_slice())?;
+        table.remove(2)?;
+    }
+    assert!(
+        transaction.allowance_charged()? >= charged_after_first,
+        "freeing never refunds"
+    );
+    {
+        let mut other = transaction.open_table(OTHER)?;
+        let refusal = storage_refusal(other.insert(2, vec![1; 12_000].as_slice()).err().expect("expected an error"));
+        assert!(matches!(
+            refusal,
+            AllowanceRefusal::Exhausted {
+                phase: AllocationPhase::Mutation,
+                ..
+            }
+        ));
+    }
+    let refusal = refusal_of(transaction.prepare().unwrap_err());
+    assert!(matches!(refusal, AllowanceRefusal::Exhausted { .. }));
+    assert_original(&database);
+    assert_eq!(rows(&database, OTHER), vec![(1, b"other".to_vec())]);
+    assert_reusable(&database)?;
+    Ok(())
+}
