+#[test]
+fn sticky_exhaustion_after_a_partial_operation_and_ignored_refusal_cannot_publish() -> TestResult {
+    let (file, database) = seeded_file()?;
+    let transaction = database.begin_write_bounded(AllocationAllowance::new(8192))?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        table.insert(2, b"tentative".as_slice())?;
+        let first = storage_refusal(table.insert(3, vec![7; 65536].as_slice()).err().expect("expected an error"));
+        assert!(matches!(first, AllowanceRefusal::Exhausted { .. }));
+        // The refusal is latched with allowance to spare: a write that fits this transaction's
+        // own page needs no allocation and goes through, but any new page is refused.
+        assert!(transaction.allowance_remaining()? > 0);
+        table.insert(4, b"small".as_slice())?;
+        let later = storage_refusal(
+            table
+                .insert(5, vec![2; 5_000].as_slice())
+                .err()
+                .expect("expected a refusal"),
+        );
+        assert_eq!(
+            later,
+            AllowanceRefusal::Latched {
+                phase: AllocationPhase::Mutation
+            }
+        );
+    }
+    let refusal = refusal_of(transaction.prepare().unwrap_err());
+    assert!(matches!(refusal, AllowanceRefusal::Exhausted { .. }));
+    assert_original(&database);
+    assert_reusable(&database)?;
+    drop(database);
+    assert_original(&Database::open(file.path())?);
+    Ok(())
+}
