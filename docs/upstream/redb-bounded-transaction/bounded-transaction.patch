+/// The exact charge of a fixed workload on a fresh database is deterministic: one byte less
+/// refuses, the exact allowance and one more publish, and zero refuses the first page.
+#[test]
+fn zero_exact_one_less_and_one_more_allowances() -> TestResult {
+    fn workload(database: &Database, allowance: AllocationAllowance) -> Result<u64, CommitError> {
+        let transaction = database.begin_write_bounded(allowance).map_err(|e| {
+            CommitError::Storage(StorageError::Corrupted(format!("begin: {e}")))
+        })?;
+        let value = [9; 300];
+        {
+            let mut table = transaction.open_table(TABLE).map_err(|e| {
+                CommitError::Storage(StorageError::Corrupted(format!("open: {e}")))
+            })?;
+            for key in 10..60 {
+                table.insert(key, value.as_slice())?;
+            }
+        }
+        let prepared = transaction.prepare()?;
+        let charged = prepared.allowance_charged()?;
+        prepared.publish()?;
+        Ok(charged)
+    }
+    let exact = workload(&memory_database()?, GENEROUS)?;
+    assert!(exact > 0);
+    assert_eq!(exact % 4096, 0, "extents are whole pages");
+
+    let database = memory_database()?;
+    let refusal = refusal_of(workload(&database, AllocationAllowance::new(exact - 1)).unwrap_err());
+    assert!(matches!(refusal, AllowanceRefusal::Exhausted { .. }), "{refusal:?}");
+    assert!(rows(&database, TABLE).is_empty(), "a refused workload published nothing");
+    assert_reusable(&database)?;
+
+    assert_eq!(
+        workload(&memory_database()?, AllocationAllowance::new(exact))?,
+        exact
+    );
+    assert_eq!(
+        workload(&memory_database()?, AllocationAllowance::new(exact + 1))?,
+        exact
+    );
+
+    let database = memory_database()?;
+    let transaction = database.begin_write_bounded(AllocationAllowance::new(0))?;
+    let refusal = match transaction.open_table(TABLE) {
+        Err(TableError::Storage(error)) => storage_refusal(error),
+        Err(other) => panic!("{other:?}"),
+        Ok(_) => panic!("a zero allowance admitted the first page"),
+    };
+    assert!(matches!(
+        refusal,
+        AllowanceRefusal::Exhausted {
+            phase: AllocationPhase::Mutation,
+            remaining: 0,
+            ..
+        }
+    ));
+    assert_eq!(transaction.refusal()?, Some(refusal));
+    transaction.abort()?;
+    assert_reusable(&database)?;
+    Ok(())
+}
