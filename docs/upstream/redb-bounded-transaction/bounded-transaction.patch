+#[test]
+fn bounded_reclamation_is_refused_whole_makes_monotonic_progress_and_finishes_after_readers_release()
+-> TestResult {
+    let (file, database) = seeded_file()?;
+    let transaction = database.begin_write()?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in 100..2_100 {
+            table.insert(key, [1; 900].as_slice())?;
+        }
+    }
+    transaction.commit()?;
+    // Drain the records the seeding left, so the reader below pins everything that follows. An
+    // ordinary commit's epilogue records become eligible one publication after a durable commit
+    // clears their pending marker, so the drain runs until two rounds reclaim nothing.
+    let mut idle_rounds = 0;
+    while idle_rounds < 2 {
+        let progress = database.reclaim_bounded(GENEROUS, 1_000)?;
+        if progress.records == 0 && !progress.remaining {
+            idle_rounds += 1;
+        } else {
+            idle_rounds = 0;
+        }
+    }
+    let reader = database.begin_read()?;
+    // Free thousands of pages; a bounded commit stores their records and reclaims nothing.
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    {
+        let mut table = transaction.open_table(TABLE)?;
+        for key in 100..2_100 {
+            table.remove(key)?;
+        }
+    }
+    transaction.prepare()?.publish()?;
+    assert_original(&database);
+
+    // The reader pins every freed page: nothing is eligible yet.
+    let progress = database.reclaim_bounded(GENEROUS, 1_000)?;
+    assert_eq!(progress.records, 0);
+    assert_eq!(progress.pages, 0);
+    assert_eq!(reader.open_table(TABLE)?.len()?, 2_001);
+    drop(reader);
+
+    // A refused reclamation removes nothing.
+    let refused = database.reclaim_bounded(AllocationAllowance::new(0), 1);
+    let refusal = match refused.unwrap_err() {
+        Error::Allowance(refusal) => refusal,
+        other => panic!("{other:?}"),
+    };
+    assert_eq!(refusal.phase(), AllocationPhase::Cleanup);
+
+    let mut rounds = 0;
+    let mut total_records = 0;
+    let mut total_pages = 0;
+    loop {
+        let progress = database.reclaim_bounded(AllocationAllowance::new(1 << 20), 1)?;
+        rounds += 1;
+        total_records += progress.records;
+        total_pages += progress.pages;
+        assert!(progress.records >= 1, "every round makes progress: {progress:?}");
+        assert!(progress.records <= 1, "the record bound holds: {progress:?}");
+        if !progress.remaining {
+            break;
+        }
+        assert!(rounds < 1_000);
+    }
+    assert!(total_records >= 2, "{total_records} records over {rounds} rounds");
+    assert!(total_pages >= 500, "{total_pages} pages reclaimed");
+    let done = database.reclaim_bounded(GENEROUS, 1_000)?;
+    assert_eq!(done.records, 0);
+    assert!(!done.remaining);
+    assert_reusable(&database)?;
+    drop(database);
+    let mut reopened = Database::open(file.path())?;
+    assert!(reopened.check_integrity()?);
+    assert_original(&reopened);
+    Ok(())
+}
