--- /dev/null
+++ b/fuzz/fuzz_targets/fuzz_bounded.rs
@@ -0,0 +1,274 @@
+#![no_main]
+
+//! State-machine fuzzing of bounded write transactions: mutation with an arbitrary allowance,
+//! ignored refusals, prepare, publish, abort and drop at every phase, live readers, bounded
+//! reclamation, bounded allocator-state persistence, and reopen. A model of the committed state
+//! and of every reader's snapshot is checked after each operation, and every reopen runs a full
+//! integrity check.
+
+use arbitrary::Arbitrary;
+use libfuzzer_sys::fuzz_target;
+use redb::{
+    AllocationAllowance, AllowanceRefusal, BoundedWriteTransaction, CommitError, Database, Error,
+    PreparedTransaction, ReadTransaction, ReadableDatabase, ReadableTable, StorageError,
+    TableDefinition,
+};
+use std::collections::BTreeMap;
+
+const TABLE: TableDefinition<u16, &[u8]> = TableDefinition::new("fuzz");
+const MAX_OPS: usize = 48;
+const MAX_VALUE: usize = 4 * 4096;
+
+#[derive(Arbitrary, Debug)]
+enum Op {
+    Begin { allowance: u32 },
+    Insert { key: u16, len: u16 },
+    Remove { key: u16 },
+    Prepare,
+    Publish,
+    Abort,
+    Drop,
+    BeginReader,
+    DropReader { index: u8 },
+    Reclaim { allowance: u32, records: u8 },
+    Persist { allowance: u32 },
+    Reopen,
+}
+
+#[derive(Arbitrary, Debug)]
+struct Plan {
+    ops: Vec<Op>,
+}
+
+type Model = BTreeMap<u16, Vec<u8>>;
+
+enum Pending {
+    Mutating(BoundedWriteTransaction, bool),
+    Prepared(PreparedTransaction),
+}
+
+struct Machine {
+    path: std::path::PathBuf,
+    database: Option<Database>,
+    committed: Model,
+    // The committed model plus this transaction's changes, if it publishes.
+    tentative: Model,
+    pending: Option<Pending>,
+    readers: Vec<(ReadTransaction, Model)>,
+}
+
+fn read_all(read: &ReadTransaction) -> Model {
+    let Ok(table) = read.open_table(TABLE) else {
+        return Model::new();
+    };
+    table
+        .iter()
+        .unwrap()
+        .map(|entry| {
+            let (key, value) = entry.unwrap();
+            (key.value(), value.value().to_vec())
+        })
+        .collect()
+}
+
+fn value_for(key: u16, len: u16) -> Vec<u8> {
+    let len = usize::from(len) % (MAX_VALUE + 1);
+    vec![(key % 251) as u8; len]
+}
+
+fn is_refusal(error: &StorageError) -> bool {
+    matches!(error, StorageError::Allowance(_))
+}
+
+impl Machine {
+    fn database(&mut self) -> &Database {
+        if self.database.is_none() {
+            self.database = Some(Database::create(&self.path).unwrap());
+        }
+        self.database.as_ref().unwrap()
+    }
+
+    fn verify(&mut self) {
+        // Readers see exactly the snapshot they began with.
+        for (reader, snapshot) in &self.readers {
+            assert_eq!(&read_all(reader), snapshot);
+        }
+        // Only a live write transaction defers the database; readers are independent handles.
+        if self.database.is_some() {
+            let read = self.database().begin_read().unwrap();
+            assert_eq!(read_all(&read), self.committed);
+        }
+    }
+
+    fn step(&mut self, op: Op) {
+        match op {
+            Op::Begin { allowance } => {
+                if self.pending.is_some() {
+                    return;
+                }
+                let allowance = AllocationAllowance::new(u64::from(allowance));
+                let transaction = self.database().begin_write_bounded(allowance).unwrap();
+                self.tentative = self.committed.clone();
+                self.pending = Some(Pending::Mutating(transaction, false));
+            }
+            Op::Insert { key, len } => {
+                let Some(Pending::Mutating(transaction, latched)) = self.pending.as_mut() else {
+                    return;
+                };
+                let value = value_for(key, len);
+                let outcome = match transaction.open_table(TABLE) {
+                    Ok(mut table) => table.insert(key, value.as_slice()).map(|_| ()).map_err(
+                        |error| match error {
+                            StorageError::Allowance(refusal) => refusal,
+                            other => panic!("unexpected insert error: {other:?}"),
+                        },
+                    ),
+                    Err(redb::TableError::Storage(error)) if is_refusal(&error) => {
+                        Err(match error {
+                            StorageError::Allowance(refusal) => refusal,
+                            _ => unreachable!(),
+                        })
+                    }
+                    Err(other) => panic!("unexpected open error: {other:?}"),
+                };
+                match outcome {
+                    Ok(()) => {
+                        self.tentative.insert(key, value);
+                    }
+                    Err(refusal) => {
+                        if *latched {
+                            assert!(matches!(refusal, AllowanceRefusal::Latched { .. }));
+                        }
+                        *latched = true;
+                        assert!(transaction.refusal().unwrap().is_some());
+                    }
+                }
+            }
+            Op::Remove { key } => {
+                let Some(Pending::Mutating(transaction, latched)) = self.pending.as_mut() else {
+                    return;
+                };
+                match transaction.open_table(TABLE) {
+                    Ok(mut table) => match table.remove(key) {
+                        Ok(_) => {
+                            self.tentative.remove(&key);
+                        }
+                        Err(StorageError::Allowance(_)) => *latched = true,
+                        Err(other) => panic!("unexpected remove error: {other:?}"),
+                    },
+                    Err(redb::TableError::Storage(StorageError::Allowance(_))) => {
+                        *latched = true;
+                    }
+                    Err(other) => panic!("unexpected open error: {other:?}"),
+                }
+            }
+            Op::Prepare => {
+                let Some(Pending::Mutating(transaction, latched)) = self.pending.take() else {
+                    return;
+                };
+                match transaction.prepare() {
+                    Ok(prepared) => {
+                        assert!(!latched, "a latched transaction prepared");
+                        self.pending = Some(Pending::Prepared(prepared));
+                    }
+                    Err(CommitError::Allowance(_)) => {
+                        // Aborted cleanly: nothing changed and the next writer is usable.
+                        self.tentative = self.committed.clone();
+                    }
+                    Err(other) => panic!("unexpected prepare error: {other:?}"),
+                }
+            }
+            Op::Publish => {
+                let Some(Pending::Prepared(prepared)) = self.pending.take() else {
+                    return;
+                };
+                prepared.publish().unwrap();
+                self.committed = self.tentative.clone();
+            }
+            Op::Abort => match self.pending.take() {
+                Some(Pending::Mutating(transaction, _)) => {
+                    transaction.abort().unwrap();
+                    self.tentative = self.committed.clone();
+                }
+                Some(Pending::Prepared(prepared)) => {
+                    prepared.abort().unwrap();
+                    self.tentative = self.committed.clone();
+                }
+                None => {}
+            },
+            Op::Drop => {
+                self.pending = None;
+                self.tentative = self.committed.clone();
+            }
+            Op::BeginReader => {
+                if self.readers.len() >= 4 {
+                    return;
+                }
+                let read = self.database().begin_read().unwrap();
+                let snapshot = read_all(&read);
+                assert_eq!(snapshot, self.committed);
+                self.readers.push((read, snapshot));
+            }
+            Op::DropReader { index } => {
+                if self.readers.is_empty() {
+                    return;
+                }
+                let index = usize::from(index) % self.readers.len();
+                self.readers.remove(index);
+            }
+            Op::Reclaim { allowance, records } => {
+                if self.pending.is_some() {
+                    return;
+                }
+                let allowance = AllocationAllowance::new(u64::from(allowance));
+                match self.database().reclaim_bounded(allowance, usize::from(records)) {
+                    Ok(_) | Err(Error::Allowance(_)) => {}
+                    Err(other) => panic!("unexpected reclaim error: {other:?}"),
+                }
+            }
+            Op::Persist { allowance } => {
+                if self.pending.is_some() {
+                    return;
+                }
+                let allowance = AllocationAllowance::new(u64::from(allowance));
+                match self.database().persist_allocator_state_bounded(allowance) {
+                    Ok(()) | Err(Error::Allowance(_)) => {}
+                    Err(other) => panic!("unexpected persist error: {other:?}"),
+                }
+            }
+            Op::Reopen => {
+                self.pending = None;
+                self.tentative = self.committed.clone();
+                self.readers.clear();
+                self.database = None;
+                let mut database = Database::open(&self.path).unwrap();
+                assert!(database.check_integrity().unwrap());
+                self.database = Some(database);
+            }
+        }
+        self.verify();
+    }
+}
+
+fuzz_target!(|plan: Plan| {
+    let file = tempfile::NamedTempFile::new().unwrap();
+    let mut machine = Machine {
+        path: file.path().to_path_buf(),
+        database: None,
+        committed: Model::new(),
+        tentative: Model::new(),
+        pending: None,
+        readers: Vec::new(),
+    };
+    machine.database();
+    for op in plan.ops.into_iter().take(MAX_OPS) {
+        machine.step(op);
+    }
+    machine.pending = None;
+    machine.readers.clear();
+    machine.database = None;
+    let mut database = Database::open(&machine.path).unwrap();
+    assert!(database.check_integrity().unwrap());
+    let read = database.begin_read().unwrap();
+    assert_eq!(read_all(&read), machine.committed);
+});
