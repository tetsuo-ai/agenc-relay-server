+#[test]
+fn an_io_failure_during_publication_latches_the_database_until_reopened() -> TestResult {
+    let backend = RecordingBackend::default();
+    let database = Database::builder().create_with_backend(backend.clone())?;
+    seed(&database)?;
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    transaction
+        .open_table(TABLE)?
+        .insert(2, b"tentative".as_slice())?;
+    let prepared = transaction.prepare()?;
+    let writes = backend.state.lock().unwrap().writes;
+    backend.fail_write_at(writes + 1);
+    let error = prepared.publish().unwrap_err();
+    assert!(matches!(error, CommitError::Storage(StorageError::Io(_))), "{error:?}");
+    // Real uncertain I/O forces reconciliation: no further writer until the database is reopened.
+    assert!(database.begin_write().is_err());
+    assert!(database
+        .begin_write_bounded(GENEROUS)
+        .is_err());
+    let image = backend.crash_image();
+    std::mem::forget(database);
+    let mut reopened = Database::builder().create_with_backend(RecordingBackend::from_image(image))?;
+    assert!(reopened.check_integrity()?);
+    let rows = rows(&reopened, TABLE);
+    assert!(rows.len() == 1 || rows.len() == 2, "{rows:?}");
+    assert_reusable(&reopened)?;
+    Ok(())
+}
