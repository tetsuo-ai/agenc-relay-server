+#[test]
+fn extreme_key_and_value_shapes_publish_and_survive_reopen() -> TestResult {
+    const SHAPES: TableDefinition<&[u8], &[u8]> = TableDefinition::new("shapes");
+    let (file, database) = seeded_file()?;
+    let long_key = vec![0xAB; 4_000];
+    let big_value = vec![0xCD; 3 << 20];
+    let transaction = database.begin_write_bounded(GENEROUS)?;
+    {
+        let mut table = transaction.open_table(SHAPES)?;
+        table.insert(b"".as_slice(), b"".as_slice())?;
+        table.insert(b"k".as_slice(), big_value.as_slice())?;
+        table.insert(long_key.as_slice(), b"v".as_slice())?;
+        // Mixed large and small leaves in one ordering.
+        for key in 0..64_u8 {
+            let value = if key % 2 == 0 {
+                vec![key; 5_000]
+            } else {
+                vec![key; 3]
+            };
+            table.insert([key].as_slice(), value.as_slice())?;
+        }
+    }
+    let prepared = transaction.prepare()?;
+    assert!(prepared.allowance_charged()? >= 3 << 20);
+    prepared.publish()?;
+    drop(database);
+    let mut reopened = Database::open(file.path())?;
+    assert!(reopened.check_integrity()?);
+    let read = reopened.begin_read()?;
+    let table = read.open_table(SHAPES)?;
+    assert_eq!(table.get(b"".as_slice())?.unwrap().value(), b"");
+    assert_eq!(table.get(b"k".as_slice())?.unwrap().value().len(), 3 << 20);
+    assert_eq!(table.get(long_key.as_slice())?.unwrap().value(), b"v");
+    assert_eq!(table.len()?, 67);
+    Ok(())
+}
